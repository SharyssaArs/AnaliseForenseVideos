# ==========================================
# DATABASE
# ==========================================
# URL de conexão do banco MySQL
DATABASE_URL=mysql+pymysql://usuario_exemplo:senha_secreta@localhost:3306/analise_db
# URL de conexão do Redis
REDIS_URL=redis://localhost:6379/0

# ==========================================
# SEGURANÇA (Criptografa os dados)
# ==========================================
# Chave secreta usada para gerar e validar tokens JWT
SECRET_KEY=sua_chave_secreta_aqui_12345
# Algoritmo utilizado para assinatura dos tokens JWT
ALGORITHM=HS256
# Tempo de expiração do token JWT em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# API E PROCESSAMENTO
# ==========================================
# Chave da API utilizada para integração com Reality Defender
REALITY_DEFENDER_API_KEY=chave_exemplo_rd_9999
# Limite mínimo de confiança para considerar um vídeo como deepfake
DEEPFAKE_THRESHOLD=0.50

# ==========================================
# UPLOAD
# ==========================================
# Tamanho máximo permitido para upload de arquivos em MB
MAX_FILE_SIZE_MB=500
# Diretório onde os vídeos enviados serão armazenados
UPLOAD_DIR=./uploads

# ==========================================
# APLICAÇÃO
# ==========================================
# Ambiente atual da aplicação (development | testing | production)
ENVIRONMENT=development
# Ativa/desativa modo debug da aplicação
DEBUG=true
# Prefixo padrão das rotas da API 
API_V1_PREFIX=/api/v1
# Nível de detalhamento dos logs da aplicação (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO